---
// 9. PAGE HERO — currently used on home only (see index.astro). Dark
// section, handwritten display tagline, heading with <em>-marked words
// in accent italic, a paragraph slot for supporting copy, and a
// circular photo on the right.
//
// Heading goes through the "heading" named slot rather than a plain
// string prop so the caller can mark specific words with <em> for the
// italic + accent treatment, e.g.:
//   <Fragment slot="heading">I design with <em>empathy</em>.</Fragment>
// The default slot holds any number of supporting paragraphs below
// the heading.
import { withBase } from "../../lib/site";

interface Props {
  tagline?: string;
  photo: string;
  photoAlt: string;
}

const { tagline, photo, photoAlt } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__inner">
    <div class="page-hero__photo">
      <img src={withBase(photo)} alt={photoAlt} />
    </div>

    <div class="page-hero__text">
      {tagline && <p class="page-hero__tagline">{tagline}</p>}
      <h1 class="page-hero__heading"><slot name="heading" /></h1>
      <div class="page-hero__body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .page-hero__inner {
    max-width: min(var(--width-media), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .page-hero__text {
    max-width: min(var(--width-prose), 100%);
  }

  /* Same handwritten-display treatment as the case study lead line:
     --font-accent (Caveat) at display scale in accent-deep gold. Kept
     consistent across the site rather than inventing a second accent
     voice for the homepage specifically. */
  .page-hero__tagline {
    margin: 0 0 var(--space-md);
    color: var(--color-accent-deep);
    font-family: var(--font-accent);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    line-height: 1.2;
  }

  .page-hero__heading {
    margin: 0 0 var(--space-md);
    max-width: 46ch;
    font-size: var(--size-h1-fluid);
    line-height: 1.4;
    color: var(--color-text);
  }

  /* :global because heading content arrives via a named slot, which
     keeps the scope attribute of whichever page provided it, not this
     component's — a plain scoped selector would never match it. The
     heading itself is full-strength text colour throughout (matching
     Footer's "Let's connect" pattern), so emphasis here comes from
     weight alone rather than a colour shift. */
  .page-hero__heading :global(em) {
    font-style: normal;
    font-weight: var(--weight-semibold);
  }

  /* Same :global reasoning as the heading — paragraphs arrive via the
     default slot from index.astro. */
  .page-hero__body :global(p) {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text);
  }

  .page-hero__body :global(p + p) {
    margin-top: var(--space-md);
  }

  .page-hero__photo {
    display: none;
  }

  .page-hero__photo img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio-square);
    border-radius: 50%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .page-hero__inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .page-hero__photo {
      display: block;
      width: 30%;
      flex-shrink: 0;
    }
  }
</style>
