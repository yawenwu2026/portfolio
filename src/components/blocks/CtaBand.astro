---
// 13. CTA BAND — the only dark section on the site. Use once, at the
// bottom of the home page.
interface Props {
  heading: string;
  buttonText: string;
  buttonHref: string;
}

const { heading, buttonText, buttonHref } = Astro.props;
---

<section class="cta-band">
  <div class="cta-band__inner">
    <h2 class="cta-band__heading">{heading}</h2>
    <a class="button" href={buttonHref}>{buttonText}</a>
  </div>
</section>

<style>
  .cta-band {
    background-color: var(--color-inverse-bg);
    color: var(--color-text-inverse);
  }

  .cta-band__inner {
    max-width: min(var(--width-prose), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    padding-block: var(--space-section);
    text-align: center;
  }

  .cta-band__heading {
    margin: 0 0 var(--space-md);
    color: var(--color-text-inverse);
  }
</style>
