---
// 10. CASE HERO — case study page header. Mirrors the .hero markup in
// src/layouts/CaseStudy.astro, which is what actually renders on a case
// study page — this component exists only for the styleguide, so keep
// the two in sync by hand whenever one changes.
import { withBase } from "../../lib/site";

interface Props {
  title: string;
  subtitle: string;
  company: string;
  role: string;
  team?: string;
  platform: string;
  timeline: string;
  isPersonalProject?: boolean;
  coverImage: string;
  coverAlt: string;
}

const { title, subtitle, company, role, team, platform, timeline, isPersonalProject, coverImage, coverAlt } =
  Astro.props;
---

<header class="case-hero">
  <div class="case-hero__grid">
    <div class="case-hero__intro">
      {isPersonalProject && <p class="case-hero__pill">Personal project</p>}
      <h1 class="case-hero__title">{title}</h1>
      <p class="case-hero__subtitle">{subtitle}</p>

      <dl class="case-hero__meta">
        <div class="case-hero__meta-row">
          <dt>Company</dt>
          <dd>{company}</dd>
        </div>
        <div class="case-hero__meta-row">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        {
          team && (
            <div class="case-hero__meta-row">
              <dt>Team</dt>
              <dd>{team}</dd>
            </div>
          )
        }
        <div class="case-hero__meta-row">
          <dt>Platform</dt>
          <dd>{platform}</dd>
        </div>
        <div class="case-hero__meta-row">
          <dt>Timeline</dt>
          <dd>{timeline}</dd>
        </div>
      </dl>
    </div>

    <img class="case-hero__image" src={withBase(coverImage)} alt={coverAlt} />
  </div>
</header>

<style>
  .case-hero {
    padding-block: var(--space-section) var(--space-lg);
  }

  .case-hero__grid {
    max-width: min(var(--width-media), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .case-hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-xl);
    }
  }

  .case-hero__intro {
    max-width: var(--width-prose);
  }

  .case-hero__pill {
    display: inline-block;
    margin: 0 0 var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-brand-soft);
    border-radius: var(--radius);
    color: var(--color-brand-deep);
    font-size: var(--size-xs);
  }

  .case-hero__title {
    margin: 0 0 var(--space-sm);
  }

  .case-hero__subtitle {
    margin: 0 0 var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--size-h3);
    line-height: var(--leading-heading);
  }

  .case-hero__meta {
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .case-hero__meta-row {
    display: grid;
    grid-template-columns: minmax(5rem, 1fr) 2fr;
    gap: var(--space-xs) var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .case-hero__meta-row:last-child {
    border-bottom: none;
  }

  .case-hero__meta-row dt {
    margin: 0;
    color: var(--color-accent-deep);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .case-hero__meta-row dd {
    margin: 0;
    font-size: var(--size-sm);
  }

  .case-hero__image {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio-tall);
    object-fit: cover;
    object-position: 50% 30%;
  }
</style>
