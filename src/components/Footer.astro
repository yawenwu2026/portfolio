---
import { WORDMARK, MAILTO_HREF, LINKEDIN_URL, EMAIL } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__connect">
    <h2 class="site-footer__heading">Let's connect</h2>
    <p class="site-footer__tagline">Get in touch about new roles, collaborations, or just to say hello.</p>

    <div class="site-footer__icons">
      <a class="site-footer__icon" href={MAILTO_HREF} aria-label={`Email ${EMAIL}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </a>
      <a class="site-footer__icon" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>© {year} {WORDMARK}</p>
    <p>Built with Astro</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .site-footer__connect {
    max-width: min(var(--width-prose), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    padding-block: var(--space-section);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .site-footer__heading {
    margin: 0;
    font-size: var(--size-h1);
  }

  .site-footer__tagline {
    margin: 0;
    color: var(--color-text-muted);
  }

  .site-footer__icons {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .site-footer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .site-footer__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-footer__icon:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .site-footer__bottom {
    max-width: min(var(--width-media), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--size-sm);
  }

  .site-footer__bottom p {
    margin: 0;
  }
</style>
