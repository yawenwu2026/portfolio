---
import { getCollection, render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      otherEntries: sorted.filter((e) => e.id !== entry.id),
    },
  }));
}

const { entry, otherEntries } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudy
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  company={entry.data.company}
  role={entry.data.role}
  team={entry.data.team}
  platform={entry.data.platform}
  timeline={entry.data.timeline}
  isPersonalProject={entry.data.isPersonalProject}
  coverImage={entry.data.coverImage}
  coverAlt={entry.data.coverAlt}
  heroPosition={entry.data.heroPosition}
  summary={entry.data.summary}
  otherEntries={otherEntries.map((e) => ({
    slug: e.id,
    title: e.data.title,
    subtitle: e.data.subtitle,
    image: e.data.thumbImage ?? e.data.coverImage,
    imageAlt: e.data.coverAlt,
  }))}
>
  <Content />
</CaseStudy>
