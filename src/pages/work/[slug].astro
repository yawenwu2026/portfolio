---
import { getCollection, render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: sorted[index - 1],
      nextEntry: sorted[index + 1],
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudy
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  company={entry.data.company}
  role={entry.data.role}
  team={entry.data.team}
  platform={entry.data.platform}
  timeline={entry.data.timeline}
  isPersonalProject={entry.data.isPersonalProject}
  coverImage={entry.data.coverImage}
  coverAlt={entry.data.coverAlt}
  summary={entry.data.summary}
  prevEntry={prevEntry && { slug: prevEntry.id, title: prevEntry.data.title }}
  nextEntry={nextEntry && { slug: nextEntry.id, title: nextEntry.data.title }}
>
  <Content />
</CaseStudy>
