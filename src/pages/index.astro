---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/blocks/PageHero.astro";
import { withBase } from "../lib/site";

const entries = await getCollection("work");
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);

const description =
  "Fifteen years across field service, transit, and navigation. I design for people wearing gloves, standing in the rain, with one bar of signal.";
---

<BaseLayout title="Yawen Wu — Senior Product Designer" description={description}>
  <PageHero eyebrow="Hello, I'm Yawen" photo="/images/shared/yawen-photo.png" photoAlt="Yawen Wu">
    <Fragment slot="heading">
      A Senior Product Designer based in Melbourne, 15+ years translating between user needs and business
      goals across enterprise <em>SaaS</em>, <em>financial services</em>, <em>commerce</em> and{" "}
      <em>digital maps</em>.
    </Fragment>
  </PageHero>

  <section id="work" class="work" aria-label="Selected work">
    <div class="work__grid">
      {
        sorted.map((entry) => (
          <a class="card" href={withBase(`/work/${entry.id}`)}>
            <img
              class="card__image"
              src={withBase(entry.data.thumbImage ?? entry.data.coverImage)}
              alt={entry.data.coverAlt}
              style={`object-position: ${entry.data.coverPosition ?? "50% 50%"};`}
              loading="lazy"
              data-fade
            />
            <div class="card__body">
              {entry.data.isPersonalProject && <p class="card__label">Personal project</p>}
              <h2 class="card__title">{entry.data.title}</h2>
              <p class="card__meta">
                {entry.data.company} · {entry.data.timeline}
              </p>
              <p class="card__summary">{entry.data.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .work {
    max-width: min(var(--width-media), 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    padding-block: var(--space-section);
  }

  /* Auto-fit rather than a fixed column count per breakpoint: within
     each tier the grid still degrades continuously as the viewport
     resizes, only the minmax floor changes at 768/1024 to bias the
     count toward the spec (2 across, then 3). The two px values are a
     practical floor for this one grid given --width-media and
     --space-lg's gap, not reusable design values, hence raw numbers
     rather than tokens — same reasoning as the breakpoints above. */
  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .work__grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .work__grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: inherit;
    text-decoration: none;
  }

  .card__image {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio-standard);
    object-fit: cover;
  }

  .card__label {
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .card__title {
    margin: 0 0 var(--space-xs);
    font-size: var(--size-h2);
    font-weight: var(--weight-semibold);
  }

  .card__meta {
    margin: 0 0 var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--size-sm);
  }

  .card__summary {
    margin: 0;
    color: var(--color-text);
  }
</style>
