---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/site";

interface OtherEntry {
  slug: string;
  title: string;
  subtitle: string;
  image: string;
  imageAlt: string;
}

interface Props {
  title: string;
  subtitle: string;
  company: string;
  role: string;
  team?: string;
  platform: string;
  timeline: string;
  isPersonalProject: boolean;
  coverImage: string;
  summaryImage: string;
  coverAlt: string;
  heroPosition?: string;
  summary: string;
  otherEntries: OtherEntry[];
}

const {
  title,
  subtitle,
  company,
  role,
  team,
  platform,
  timeline,
  isPersonalProject,
  coverImage,
  summaryImage,
  coverAlt,
  heroPosition,
  summary,
  otherEntries,
} = Astro.props;
---

<BaseLayout title={`${title} — Yawen Wu`} description={summary} ogImage={coverImage} ogType="article">
  <article class="layout">
    <aside class="summary">
      <img
        class="summary__cover"
        src={withBase(summaryImage)}
        alt={coverAlt}
        style={`object-position: ${heroPosition ?? "50% 30%"};`}
      />

      {isPersonalProject && <p class="summary__label">Personal project</p>}
      <h1 class="summary__title">{title}</h1>
      <p class="summary__subtitle">{subtitle}</p>

      <dl class="summary__meta">
        <div class="summary__meta-row">
          <dt>Company</dt>
          <dd>{company}</dd>
        </div>
        <div class="summary__meta-row">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        {team && (
          <div class="summary__meta-row">
            <dt>Team</dt>
            <dd>{team}</dd>
          </div>
        )}
        <div class="summary__meta-row">
          <dt>Platform</dt>
          <dd>{platform}</dd>
        </div>
        <div class="summary__meta-row">
          <dt>Timeline</dt>
          <dd>{timeline}</dd>
        </div>
      </dl>

      <a class="summary__home-link" href={withBase("/")}>&larr; Back to home</a>
    </aside>

    <div class="case-study-body">
      <slot />
    </div>

    <aside class="related" aria-label="Other case studies">
      <p class="related__eyebrow">More work</p>
      <ul class="related__list">
        {otherEntries.map((entry) => (
          <li>
            <a class="related__card" href={withBase(`/work/${entry.slug}`)}>
              <img class="related__image" src={withBase(entry.image)} alt={entry.imageAlt} loading="lazy" />
              <span class="related__title">{entry.title}</span>
              <span class="related__subtitle">{entry.subtitle}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </article>
</BaseLayout>

<script>
  // Shared by every WideDiagram instance on the page, however it was
  // rendered — the real component (fsm-mobile.mdx) or the raw HTML the
  // plain-Markdown plugin emits for tramtracker.md / naviking.md. One
  // delegated listener, so it works no matter how many are on the page.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest("[data-wide-trigger]");
    if (trigger) {
      const dialog = trigger.closest("[data-wide-diagram]")?.querySelector("[data-wide-dialog]");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closeButton = target.closest("[data-wide-close]");
    if (closeButton) {
      closeButton.closest("dialog")?.close();
      return;
    }

    // Click on the ::backdrop lands on the <dialog> element itself.
    if (target instanceof HTMLDialogElement && target.hasAttribute("data-wide-dialog")) {
      target.close();
    }
  });
</script>

<style>
  /* ---------- Three-column layout ----------
     Mobile: single column, source order is summary -> body -> related,
     which is also the sensible reading order, so no explicit `order`
     rules are needed. Desktop: summary and related become narrow rails
     flanking the details column. Related is sticky (explicit request);
     summary scrolls with the page, matching the reference layout. */
  .layout {
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
    max-width: min(1320px, 100% - 2 * var(--space-gutter));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(200px, 240px) minmax(0, 1fr) minmax(240px, 300px);
      align-items: start;
      gap: var(--space-lg);
    }
  }

  /* ---------- Left rail: project summary ---------- */
  .summary__cover {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio-standard);
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-md);
  }

  .summary__label {
    display: inline-block;
    margin: 0 0 var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: var(--size-sm);
  }

  .summary__title {
    margin: 0 0 var(--space-sm);
    font-size: var(--size-h2);
  }

  .summary__subtitle {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--size-sm);
    line-height: var(--leading-heading);
  }

  .summary__meta {
    margin: 0 0 var(--space-md);
  }

  .summary__meta-row {
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .summary__meta-row:last-child {
    border-bottom: none;
  }

  .summary__meta-row dt {
    color: var(--color-accent-deep);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .summary__meta-row dd {
    margin: 0.25rem 0 0;
    font-size: var(--size-sm);
  }

  .summary__home-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-muted);
    font-size: var(--size-sm);
  }

  /* ---------- Middle: case study body ---------- */
  .case-study-body {
    min-width: 0;
  }

  /* ---------- Right rail: other case studies ---------- */
  .related__eyebrow {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .related__card {
    display: block;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .related__image {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio-wide);
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .related__card:hover .related__image {
    transform: scale(1.03);
  }

  .related__title {
    display: block;
    margin: var(--space-sm) var(--space-sm) 0;
    font-family: var(--font-heading);
    font-size: var(--size-sm);
    font-weight: var(--weight-semibold);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 150ms ease;
  }

  .related__card:hover .related__title {
    text-decoration-color: currentColor;
  }

  .related__subtitle {
    display: block;
    margin: 0.25rem var(--space-sm) var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--size-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .related__image,
    .related__title {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .related {
      position: sticky;
      top: calc(var(--space-sm) * 2 + 3rem);
    }
  }
</style>
